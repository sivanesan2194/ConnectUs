<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- RelativeLayout as a container for the fragment and buttons -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Group Name Header -->
        <LinearLayout
            android:id="@+id/header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@android:color/white"
            android:elevation="8dp"
            android:padding="15dp"
            android:layout_alignParentTop="true"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_group"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/groupNameTextView"
                android:layout_width="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_height="wrap_content"
                android:text="Group Name"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@android:color/black" />
        </LinearLayout>

        <!-- Google Map Fragment (Positioned below the header, but above avatars section) -->

        <!-- Bottom Avatars Section -->
        <fragment
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_above="@id/avatars_section"
            android:layout_below="@id/header_container"
            android:layout_alignParentStart="true"
            android:layout_marginStart="0dp"
            android:layout_marginTop="-3dp"
            android:layout_marginBottom="3dp" />

        <LinearLayout
            android:id="@+id/avatars_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:elevation="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/membersTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Group Members"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/black" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/avatar_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:layout_gravity="center_vertical"
                    android:baselineAligned="false" />
            </HorizontalScrollView>
        </LinearLayout>

        <ImageView
            android:id="@+id/focusme"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_above="@id/avatars_section"
            android:layout_marginBottom="96dp"
            android:layout_marginEnd="12dp"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_my_locations"
            android:background="@drawable/bg_circle_map"
            android:backgroundTint="@color/bc"
            android:padding="10dp"/>
        <!-- Satellite View Button -->
        <ImageView
            android:id="@+id/mapTypeButton"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_above="@id/avatars_section"
            android:layout_marginBottom="20dp"
            android:layout_marginEnd="12dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_circle_sat"
            android:src="@drawable/ic_map"
            android:textColor="@android:color/white"
            android:padding="10dp"/>

    </RelativeLayout>

</FrameLayout>
