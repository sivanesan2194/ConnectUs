<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".settings"
    android:background="#FAFAFA">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="10dp"
        android:scrollbars="vertical"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:spacing="12dp">


            <!-- Profile Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@android:color/white"
                android:elevation="2dp"
                android:layout_marginTop="20dp"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical">

                <!-- User Image -->
                <!-- User Image with Edit Icon -->
                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:id="@+id/tv_user_initials"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:gravity="center"
                        android:text="A"
                        android:textColor="@android:color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_gravity="center"
                        android:background="@drawable/circle_background"/>


                </FrameLayout>


                <!-- User Info -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="User Name"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#212121" />

                    <TextView
                        android:id="@+id/tv_user_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email: user@example.com"
                        android:textColor="#555" />

                    <TextView
                        android:id="@+id/tv_user_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="User ID: abc123"
                        android:textColor="#888" />
                </LinearLayout>
            </LinearLayout>

            <!-- Notification and Display Settings -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="1dp"
                android:padding="16dp"
                android:backgroundTint="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp"
                    android:divider="?android:attr/dividerHorizontal"
                    android:showDividers="middle"
                    android:dividerPadding="16dp">

                    <!-- Notification Settings -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Notifications"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:paddingBottom="16dp"
                        android:textColor="#333"/>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_push_notifications"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="General Notifications"
                        android:textSize="16sp"/>

                    <!-- Display -->

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Privacy and Security Settings -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardElevation="1dp"
                android:padding="16dp"
                android:backgroundTint="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:divider="?android:attr/dividerHorizontal"
                    android:showDividers="middle"
                    android:layout_marginTop="10dp"
                    android:dividerPadding="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Privacy and Security"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:paddingBottom="16dp"
                        android:textColor="#333"/>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_disable_location"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Disable Location Access"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:text="Phone Number Visibility"
                        android:paddingTop="12dp"
                        android:paddingBottom="16dp"
                        android:layout_marginTop="10dp"
                        android:textSize="16sp"
                        android:textColor="#333" />

                    <RadioGroup
                        android:id="@+id/radio_phone_visibility"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="4dp"
                        android:paddingBottom="8dp">

                        <RadioButton
                            android:id="@+id/radio_public"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Public"
                            android:textSize="16sp"
                            android:paddingEnd="16dp" />

                        <RadioButton
                            android:id="@+id/radio_private"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Private"
                            android:textSize="16sp" />
                    </RadioGroup>

                    <TextView
                        android:id="@+id/tv_change_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:text="Change Password"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:textSize="16sp" />


                    <TextView
                        android:id="@+id/tv_delete_account"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Delete Account"
                        android:paddingTop="16dp"
                        android:paddingBottom="24dp"
                        android:textSize="16sp"
                        android:textColor="@android:color/holo_red_dark" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- App Info -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                app:cardElevation="1dp"
                android:padding="16dp"
                android:backgroundTint="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp"
                    android:showDividers="middle">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="App Info"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:paddingBottom="16dp"
                        android:textColor="#333"/>

                    <TextView
                        android:id="@+id/tv_terms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Terms and Conditions"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_privacy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Privacy Policy"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_app_version"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Version 1.6.2"
                        android:paddingTop="12dp"
                        android:textSize="16sp"
                        android:paddingBottom="12dp"
                        android:textColor="#888" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Feedback Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="1dp"
                android:padding="16dp"
                android:backgroundTint="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Feedback"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"
                        android:textSize="16sp"
                        android:paddingBottom="8dp"
                        android:textColor="#333" />

                    <EditText
                        android:id="@+id/et_feedback"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:hint="Write your feedback here..."
                        android:gravity="top|start"
                        android:padding="12dp"
                        android:background="@android:drawable/edit_text"
                        android:textSize="15sp"
                        android:inputType="textMultiLine"
                        android:maxLines="5"
                        android:minLines="3" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:layout_marginTop="12dp">

                        <Button
                            android:id="@+id/btn_submit_feedback"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Submit"
                            android:textSize="14sp"
                            android:textColor="@android:color/white"
                            android:textAllCaps="false"
                            android:backgroundTint="@color/orange"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <!-- Logout Button -->
            <Button
                android:id="@+id/btn_logout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:backgroundTint="@color/orange"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:layout_marginBottom="20dp"
                android:paddingBottom="6dp"
                android:textColor="@android:color/white"/>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
