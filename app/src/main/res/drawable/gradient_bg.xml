<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow Layer -->
    <item android:top="100dp" android:left="100dp" android:bottom="100dp">
        <shape android:shape="rectangle">
            <solid android:color="#40000000" />  <!-- Semi-transparent Black Shadow -->
            <corners android:radius="22dp" />  <!-- Rounded corners -->
        </shape>
    </item>

    <!-- Gradient Background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#6656E6"
                android:endColor="#FFFFFF"
                android:type="linear"/>
            <corners android:radius="12dp" />  <!-- Rounded corners to match shadow -->
        </shape>
    </item>

</layer-list>
