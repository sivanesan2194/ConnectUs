<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval"
    android:innerRadius="50dp">

    <!-- Fill color -->
    <solid android:color="@color/glass_white" />

    <!-- Border (Stroke) -->
    <stroke
        android:width="1dp"
        android:color="@android:color/black" />

    <!-- Size -->
    <size
        android:width="60dp"
        android:height="60dp" />
</shape>
